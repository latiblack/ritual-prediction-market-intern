# ── Required ──
PRIVATE_KEY=0xabcdef1234...  # Deployer wallet funded with testnet RITUAL
RITUAL_RPC_URL=https://rpc.ritualfoundation.org
RITUAL_VERIFIER_URL=https://rpc.ritualfoundation.org/api/verify

# ── Executor Addresses ──
# Get these by querying TEEServiceRegistry on Ritual Chain:
#   cast call 0x9644e8562cE0Fe12b4deeC4163c064A8862Bf47F \
#     "getServicesByCapability(uint8,bool)((address,address,uint8,bytes,bytes,bytes32,uint8),bool,bytes32[])" \
#     0 true --rpc-url $RITUAL_RPC_URL
HTTP_EXECUTOR=0x0000000000000000000000000000000000000000
LLM_EXECUTOR=0x0000000000000000000000000000000000000000
